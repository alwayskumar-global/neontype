{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "effectInstances": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effectId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "character",
              "word",
              "line"
            ]
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "effectId",
          "granularity",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "paramDescriptors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "binding": {
                "type": "object",
                "properties": {
                  "effectInstanceIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "paramKey": {
                    "type": "string"
                  }
                },
                "required": [
                  "effectInstanceIndex",
                  "paramKey"
                ],
                "additionalProperties": false
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "default": {
                "type": "number"
              }
            },
            "required": [
              "key",
              "type",
              "binding",
              "min",
              "max",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "enum"
              },
              "binding": {
                "type": "object",
                "properties": {
                  "effectInstanceIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "paramKey": {
                    "type": "string"
                  }
                },
                "required": [
                  "effectInstanceIndex",
                  "paramKey"
                ],
                "additionalProperties": false
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "type",
              "binding",
              "values",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "color"
              },
              "binding": {
                "type": "object",
                "properties": {
                  "effectInstanceIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "paramKey": {
                    "type": "string"
                  }
                },
                "required": [
                  "effectInstanceIndex",
                  "paramKey"
                ],
                "additionalProperties": false
              },
              "default": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "key",
              "type",
              "binding",
              "default"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "effectInstances",
    "paramDescriptors"
  ],
  "additionalProperties": false
}
