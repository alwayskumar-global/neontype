        "selector": "JSXOpeningElement[name.name='ColorSwatch'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hover|focus|active)$/]",
        "message": "<ColorSwatch> state must be one of 'hover' | 'focus' | 'active'."
