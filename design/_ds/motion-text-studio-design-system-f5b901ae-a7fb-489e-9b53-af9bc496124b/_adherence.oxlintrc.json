        "message": "<EasingCurve> easing must be one of 'linear' | 'easeIn' | 'easeOut' | 'easeInOut'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|help|error|children|key|ref|className|style|children)$/]",
